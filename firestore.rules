
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================
    // 1. AUTHENTICATION
    // =====================================

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.admin == true;
    }

    function isSuperAdmin() {
      return signedIn()
        && request.auth.token.superAdmin == true;
    }

    function isPlatformAdmin() {
      return isAdmin() || isSuperAdmin();
    }

    function isDriver(uid) {
      return signedIn()
        && request.auth.uid == uid
        && get(
          /databases/$(database)/documents/users/$(uid)
        ).data.role == 'driver';
    }

    // =====================================
    // 2. USER ACCOUNTS
    // =====================================

    match /users/{uid} {

      allow read: if isOwner(uid) || isPlatformAdmin();

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasAll([
          'email',
          'role',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name',
          'email',
          'phone',
          'whatsapp',
          'photoURL',
          'role',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.email is string
        && request.resource.data.role in [
          'driver',
          'customer',
          'broker'
        ]
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && (
          (
            request.resource.data.role == 'customer'
            && request.resource.data.status == 'active'
          )
          ||
          (
            request.resource.data.role in [
              'driver',
              'broker'
            ]
            && request.resource.data.status == 'pending'
          )
        );

      allow update: if (
        isOwner(uid)
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'name',
            'phone',
            'whatsapp',
            'photoURL',
            'updatedAt'
          ])
      ) || isPlatformAdmin();

      allow delete: if isSuperAdmin();
    }

    // =====================================
    // 3. DRIVER PROFILES
    // =====================================

    match /drivers/{uid} {

      allow read: if isOwner(uid) || isPlatformAdmin();

      allow create: if isDriver(uid)
        && request.resource.data.keys().hasAll([
          'verificationStatus',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name',
          'email',
          'phone',
          'whatsapp',
          'address',
          'licenseNumber',
          'vehicleDetails',
          'verificationStatus',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.verificationStatus == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if (
        isOwner(uid)
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'phone',
            'whatsapp',
            'address',
            'vehicleDetails',
            'updatedAt'
          ])
      ) || isPlatformAdmin();

      allow delete: if isSuperAdmin();
    }

    // =====================================
    // 4. VEHICLES
    // =====================================

    match /vehicles/{vehicleId} {

      // Private vehicle records
      allow read: if (
        signedIn()
        && resource.data.ownerUid == request.auth.uid
      ) || isPlatformAdmin();

      // Driver creates a vehicle under their UID
      allow create: if isDriver(
          request.resource.data.ownerUid
        )
        && request.resource.data.keys().hasAll([
          'ownerUid',
          'registrationNumber',
          'vehicleCategory',
          'vehicleModel',
          'seatingCapacity',
          'isPrimary',
          'verificationStatus',
          'vehicleStatus',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'ownerUid',
          'registrationNumber',
          'vehicleCategory',
          'vehicleModel',
          'seatingCapacity',
          'fuelType',
          'isPrimary',
          'verificationStatus',
          'vehicleStatus',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.registrationNumber is string
        && request.resource.data.vehicleCategory is string
        && request.resource.data.vehicleModel is string
        && request.resource.data.seatingCapacity is int
        && request.resource.data.seatingCapacity > 0
        && request.resource.data.isPrimary is bool
        && request.resource.data.verificationStatus == 'pending'
        && request.resource.data.vehicleStatus == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Owner can edit ordinary vehicle details.
      // Ownership and verification cannot be changed.
      allow update: if (
        signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.verificationStatus ==
           resource.data.verificationStatus
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'registrationNumber',
            'vehicleCategory',
            'vehicleModel',
            'seatingCapacity',
            'fuelType',
            'isPrimary',
            'updatedAt'
          ])
      ) || isPlatformAdmin();

      allow delete: if isSuperAdmin();
    }

    // =====================================
    // 5. BROKER PROFILES
    // =====================================

    match /brokers/{uid} {

      allow read: if isOwner(uid) || isPlatformAdmin();

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasAll([
          'approvalStatus',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name',
          'email',
          'phone',
          'whatsapp',
          'address',
          'approvalStatus',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.approvalStatus == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if (
        isOwner(uid)
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'phone',
            'whatsapp',
            'address',
            'updatedAt'
          ])
      ) || isPlatformAdmin();

      allow delete: if isSuperAdmin();
    }

    // =====================================
    // 6. PLATFORM SETTINGS
    // =====================================

    match /platformSettings/{documentId} {

      allow read: if isPlatformAdmin();

      allow write: if isSuperAdmin();
    }

    // =====================================
    // 7. DEFAULT DENY
    // =====================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
