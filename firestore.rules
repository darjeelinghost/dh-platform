
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function admin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function superAdmin() {
      return signedIn() && request.auth.token.superadmin == true;
    }

    function platformAdmin() {
      return admin() || superAdmin();
    }

    function profile(uid) {
      return get(
        /databases/$(database)/documents/users/$(uid)
      ).data;
    }

    function activeDriver() {
      return signedIn()
        && profile(request.auth.uid).role == "driver"
        && profile(request.auth.uid).status == "active";
    }

    function activePoster() {
      return signedIn()
        && profile(request.auth.uid).role in ["driver", "broker"]
        && profile(request.auth.uid).status == "active";
    }

    // USER PROFILES
    match /users/{uid} {
      allow get: if signedIn()
        && (request.auth.uid == uid || platformAdmin());

      allow list: if platformAdmin();

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role in ["driver", "broker"]
        && request.resource.data.status == "pending";

      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "displayName",
            "phone",
            "whatsapp",
            "photoURL",
            "updatedAt"
          ]);

      allow update: if platformAdmin();
      allow delete: if superAdmin();
    }

    // DRIVER PROFILES
    match /drivers/{uid} {
      allow read: if signedIn()
        && (request.auth.uid == uid || platformAdmin());

      allow create, update: if signedIn()
        && request.auth.uid == uid
        && activeDriver();

      allow delete: if platformAdmin();
    }

    // BROKER PROFILES
    match /brokers/{uid} {
      allow read: if signedIn()
        && (request.auth.uid == uid || platformAdmin());

      allow create, update: if signedIn()
        && request.auth.uid == uid
        && activePoster();

      allow delete: if platformAdmin();
    }

    // VEHICLES
    match /vehicles/{vehicleId} {
      allow create: if activeDriver()
        && request.resource.data.driverUid == request.auth.uid;

      allow read: if signedIn()
        && (resource.data.driverUid == request.auth.uid || platformAdmin());

      allow update: if signedIn()
        && resource.data.driverUid == request.auth.uid
        && request.resource.data.driverUid == resource.data.driverUid;

      allow delete: if signedIn()
        && (resource.data.driverUid == request.auth.uid || platformAdmin());
    }

    // TRIP POSTS
    match /tripPosts/{tripId} {

      allow get, list: if signedIn()
        && (
          resource.data.status == "available"
          || resource.data.posterUid == request.auth.uid
          || resource.data.assignedDriverUid == request.auth.uid
          || platformAdmin()
        );

      allow create: if activePoster()
        && request.resource.data.posterUid == request.auth.uid
        && request.resource.data.status == "available"
        && request.resource.data.source is string
        && request.resource.data.destination is string
        && request.resource.data.pickupLocation is string
        && request.resource.data.travelDate is string
        && request.resource.data.tripType is string
        && request.resource.data.vehicleType is string
        && request.resource.data.seats is int
        && request.resource.data.seats >= 1
        && request.resource.data.seats <= 30
        && request.resource.data.fare is number
        && request.resource.data.fare >= 0;

      // ATOMIC TRIP ASSIGNMENT
      allow update: if signedIn()
        && resource.data.posterUid == request.auth.uid
        && resource.data.status == "available"
        && request.resource.data.status == "assigned"
        && request.resource.data.posterUid == resource.data.posterUid
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "status",
            "assignedDriverUid",
            "assignedDriverName",
            "assignedRequestId",
            "driverCompleted",
            "posterCompleted",
            "driverPaymentConfirmed",
            "posterPaymentConfirmed",
            "paymentStatus",
            "amountPaid",
            "updatedAt"
          ])
        && getAfter(
          /databases/$(database)/documents/tripRequests/$(request.resource.data.assignedRequestId)
        ).data.status == "accepted"
        && getAfter(
          /databases/$(database)/documents/tripRequests/$(request.resource.data.assignedRequestId)
        ).data.tripId == tripId
        && getAfter(
          /databases/$(database)/documents/tripRequests/$(request.resource.data.assignedRequestId)
        ).data.driverUid == request.resource.data.assignedDriverUid
        && getAfter(
          /databases/$(database)/documents/tripRequests/$(request.resource.data.assignedRequestId)
        ).data.tripPosterUid == request.auth.uid;

      // TWO-SIDED TRIP COMPLETION
      allow update: if signedIn()
        && resource.data.status == "assigned"
        && request.resource.data.status in ["assigned", "completed"]
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "driverCompleted",
            "posterCompleted",
            "driverCompletedAt",
            "posterCompletedAt",
            "status",
            "completedAt",
            "updatedAt"
          ])
        && (
          (
            request.auth.uid == resource.data.assignedDriverUid
            && request.resource.data.driverCompleted == true
            && request.resource.data.posterCompleted == resource.data.posterCompleted
          )
          ||
          (
            request.auth.uid == resource.data.posterUid
            && request.resource.data.posterCompleted == true
            && request.resource.data.driverCompleted == resource.data.driverCompleted
          )
        )
        && (
          request.resource.data.status != "completed"
          || (
            request.resource.data.driverCompleted == true
            && request.resource.data.posterCompleted == true
          )
        );

      // POSTER RECORDS PAYMENT AMOUNT
      allow update: if signedIn()
        && resource.data.status == "completed"
        && request.resource.data.status == "completed"
        && request.resource.data.posterUid == request.auth.uid
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "amountPaid",
            "paymentStatus",
            "posterPaymentConfirmed",
            "driverPaymentConfirmed",
            "updatedAt"
          ])
        && request.resource.data.amountPaid is number
        && request.resource.data.amountPaid >= resource.data.amountPaid
        && request.resource.data.amountPaid <= resource.data.fare;

      // TWO-SIDED PAYMENT CONFIRMATION
      allow update: if signedIn()
        && resource.data.status == "completed"
        && request.resource.data.status == "completed"
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "driverPaymentConfirmed",
            "posterPaymentConfirmed",
            "paymentStatus",
            "paidAt",
            "updatedAt"
          ])
        && (
          (
            request.auth.uid == resource.data.assignedDriverUid
            && request.resource.data.driverPaymentConfirmed == true
            && request.resource.data.posterPaymentConfirmed == resource.data.posterPaymentConfirmed
          )
          ||
          (
            request.auth.uid == resource.data.posterUid
            && request.resource.data.posterPaymentConfirmed == true
            && request.resource.data.driverPaymentConfirmed == resource.data.driverPaymentConfirmed
          )
        )
        && (
          request.resource.data.paymentStatus != "paid"
          || (
            request.resource.data.driverPaymentConfirmed == true
            && request.resource.data.posterPaymentConfirmed == true
            && request.resource.data.amountPaid >= resource.data.fare
          )
        );

      // SOFT ARCHIVE: no ordinary user can permanently delete trips.
      allow delete: if superAdmin();
    }

    // TRIP REQUESTS
    match /tripRequests/{requestId} {

      allow get, list: if signedIn()
        && (
          resource.data.driverUid == request.auth.uid
          || resource.data.tripPosterUid == request.auth.uid
          || platformAdmin()
        );

      allow create: if activeDriver()
        && request.resource.data.driverUid == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.tripId is string
        && request.resource.data.tripPosterUid is string
        && request.resource.data.tripPosterUid != request.auth.uid
        && get(
          /databases/$(database)/documents/tripPosts/$(request.resource.data.tripId)
        ).data.status == "available"
        && get(
          /databases/$(database)/documents/tripPosts/$(request.resource.data.tripId)
        ).data.posterUid == request.resource.data.tripPosterUid;

      allow update: if signedIn()
        && resource.data.tripPosterUid == request.auth.uid
        && resource.data.status == "pending"
        && request.resource.data.status in ["accepted", "rejected"]
        && request.resource.data.driverUid == resource.data.driverUid
        && request.resource.data.tripId == resource.data.tripId
        && request.resource.data.tripPosterUid == resource.data.tripPosterUid
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(["status", "updatedAt"])
        && (
          request.resource.data.status == "rejected"
          || (
            getAfter(
              /databases/$(database)/documents/tripPosts/$(resource.data.tripId)
            ).data.status == "assigned"
            && getAfter(
              /databases/$(database)/documents/tripPosts/$(resource.data.tripId)
            ).data.assignedRequestId == requestId
            && getAfter(
              /databases/$(database)/documents/tripPosts/$(resource.data.tripId)
            ).data.assignedDriverUid == resource.data.driverUid
          )
        );

      allow delete: if platformAdmin();
    }

    // CENTRAL NOTIFICATIONS
    match /notifications/{notificationId} {

      allow get, list: if signedIn()
        && (
          resource.data.recipientUid == request.auth.uid
          || platformAdmin()
        );

      // Validate notification against the related trip request.
      allow create: if signedIn()
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.recipientUid is string
        && request.resource.data.tripId is string
        && request.resource.data.requestId is string
        && request.resource.data.read == false
        && exists(
          /databases/$(database)/documents/tripRequests/$(request.resource.data.requestId)
        )
        && get(
          /databases/$(database)/documents/tripRequests/$(request.resource.data.requestId)
        ).data.tripId == request.resource.data.tripId
        && (
          (
            request.resource.data.type == "trip_request_submitted"
            && request.resource.data.recipientUid == request.auth.uid
            && get(
              /databases/$(database)/documents/tripRequests/$(request.resource.data.requestId)
            ).data.driverUid == request.auth.uid
          )
          ||
          (
            request.resource.data.type == "trip_request_received"
            && get(
              /databases/$(database)/documents/tripRequests/$(request.resource.data.requestId)
            ).data.driverUid == request.auth.uid
            && get(
              /databases/$(database)/documents/tripRequests/$(request.resource.data.requestId)
            ).data.tripPosterUid == request.resource.data.recipientUid
            && get(
              /databases/$(database)/documents/tripRequests/$(request.resource.data.requestId)
            ).data.status == "pending"
          )
          ||
          (
            request.resource.data.type in [
              "trip_request_accepted",
              "trip_request_rejected"
            ]
            && get(
              /databases/$(database)/documents/tripRequests/$(request.resource.data.requestId)
            ).data.tripPosterUid == request.auth.uid
            && get(
              /databases/$(database)/documents/tripRequests/$(request.resource.data.requestId)
            ).data.driverUid == request.resource.data.recipientUid
          )
        );

      allow update: if signedIn()
        && resource.data.recipientUid == request.auth.uid
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(["read"])
        && request.resource.data.read == true;

      allow delete: if platformAdmin();
    }

    // INVOICES
    match /invoices/{invoiceId} {
      allow read: if signedIn()
        && (
          resource.data.customerUid == request.auth.uid
          || resource.data.driverUid == request.auth.uid
          || resource.data.posterUid == request.auth.uid
          || platformAdmin()
        );

      allow create, update, delete: if platformAdmin();
    }

    // PLATFORM SETTINGS
    match /platformSettings/{settingId} {
      allow read: if signedIn();
      allow write: if superAdmin();
    }

    // AUDIT LOGS
    match /auditLogs/{logId} {
      allow read, create: if platformAdmin();
      allow update, delete: if superAdmin();
    }

    // DENY ALL OTHER COLLECTIONS
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
