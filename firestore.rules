
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================
    // AUTHENTICATION HELPERS
    // =========================================

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() &&
        request.auth.token.admin == true;
    }

    function isSuperAdmin() {
      return signedIn() &&
        request.auth.token.superadmin == true;
    }

    function isPrivileged() {
      return isAdmin() || isSuperAdmin();
    }

    function userExists(uid) {
      return exists(
        /databases/$(database)/documents/users/$(uid)
      );
    }

    function activeUser() {
      return signedIn()
        && request.auth.token.email_verified == true
        && userExists(request.auth.uid)
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.status == 'active';
    }

    function activeDriver() {
      return activeUser()
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == 'driver';
    }

    function activeBroker() {
      return activeUser()
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == 'broker';
    }

    // =========================================
    // USERS
    // =========================================

    match /users/{uid} {

      allow get: if isOwner(uid) || isPrivileged();

      allow list: if isPrivileged();

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'uid',
          'displayName',
          'phone',
          'whatsapp',
          'email',
          'role',
          'status',
          'verificationStatus',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.role in ['driver', 'broker']
        && request.resource.data.status == 'pending'
        && request.resource.data.verificationStatus == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isOwner(uid)
        && activeUser()
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'displayName',
            'phone',
            'whatsapp',
            'updatedAt'
          ])
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // =========================================
    // TRIPS
    // =========================================

    match /trips/{tripId} {

      allow get, list: if isPrivileged()
        || (
          activeUser()
          && resource.data.posterUid == request.auth.uid
        )
        || (
          activeUser()
          && resource.data.assignedDriverUid == request.auth.uid
        )
        || (
          activeUser()
          && resource.data.status == 'open'
          && resource.data.moderationStatus == 'approved'
        );

      // Only approved active Driver and Broker accounts
      // can create a trip listing.
      allow create: if (
          activeDriver() || activeBroker()
        )
        && request.resource.data.keys().hasOnly([
          'pickupLocation',
          'source',
          'destination',
          'travelDate',
          'travelTime',
          'tripType',
          'vehicleType',
          'seats',
          'fare',
          'negotiable',
          'description',
          'posterUid',
          'posterName',
          'posterRole',
          'status',
          'moderationStatus',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.posterUid == request.auth.uid
        && request.resource.data.posterRole ==
          get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.role
        && request.resource.data.status == 'open'
        && request.resource.data.moderationStatus == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.pickupLocation is string
        && request.resource.data.pickupLocation.size() > 0
        && request.resource.data.pickupLocation.size() <= 150
        && request.resource.data.source is string
        && request.resource.data.source.size() > 0
        && request.resource.data.source.size() <= 150
        && request.resource.data.destination is string
        && request.resource.data.destination.size() > 0
        && request.resource.data.destination.size() <= 150
        && request.resource.data.travelDate is string
        && request.resource.data.travelTime is string
        && request.resource.data.tripType in [
          'One-way',
          'Round trip',
          'Sightseeing',
          'Airport transfer',
          'Local transfer',
          'Custom trip'
        ]
        && request.resource.data.vehicleType in [
          'Hatchback',
          'Sedan',
          'Luxury Vehicle',
          'Innova',
          'Innova Crysta',
          'Sumo',
          'Omni',
          'Van',
          'Traveller',
          'Other'
        ]
        && request.resource.data.seats is int
        && request.resource.data.seats >= 1
        && request.resource.data.seats <= 50
        && request.resource.data.fare is int
        && request.resource.data.fare > 0
        && request.resource.data.negotiable is bool
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000
        && request.resource.data.posterName is string;

      // The poster may soft-archive or restore their own
      // completed trip. Assignment and completion are backend-only.
      allow update: if activeUser()
        && resource.data.posterUid == request.auth.uid
        && resource.data.status == 'completed'
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'archived',
            'archivedAt',
            'updatedAt'
          ])
        && request.resource.data.archived is bool
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // =========================================
    // TRIP REQUESTS
    // =========================================

    match /tripRequests/{requestId} {

      // Request creation, acceptance and rejection
      // are exclusively controlled by Cloud Functions.
      allow create, update, delete: if false;

      // Driver and poster can read their own requests.
      // Admins can read all requests.
      allow get, list: if isPrivileged()
        || (
          activeUser()
          && (
            resource.data.driverUid == request.auth.uid
            || resource.data.posterUid == request.auth.uid
          )
        );
    }

    // =========================================
    // NOTIFICATIONS
    // =========================================

    match /notifications/{notificationId} {

      allow get, list: if isPrivileged()
        || (
          signedIn()
          && resource.data.recipientUid == request.auth.uid
        );

      allow create: if false;

      allow update: if signedIn()
        && resource.data.recipientUid == request.auth.uid
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(['read', 'readAt'])
        && request.resource.data.read == true;

      allow delete: if false;
    }

    // =========================================
    // PAYMENT RECORDS
    // =========================================

    match /paymentRecords/{paymentId} {

      allow get, list: if isPrivileged()
        || (
          activeUser()
          && (
            resource.data.posterUid == request.auth.uid
            || resource.data.driverUid == request.auth.uid
          )
        );

      allow create, update, delete: if false;
    }

    // =========================================
    // COMPLAINTS
    // =========================================

    match /complaints/{complaintId} {

      allow get, list: if isPrivileged()
        || (
          signedIn()
          && resource.data.reporterUid == request.auth.uid
        );

      allow create: if activeUser()
        && request.resource.data.keys().hasOnly([
          'reporterUid',
          'tripId',
          'subject',
          'description',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update, delete: if false;
    }

    // =========================================
    // DRIVER DOCUMENTS
    // =========================================

    match /driverDocuments/{documentId} {

      allow get, list: if isPrivileged()
        || (
          activeUser()
          && resource.data.ownerUid == request.auth.uid
        );

      allow create, update, delete: if false;
    }

    // =========================================
    // AUDIT LOGS
    // =========================================

    match /auditLogs/{logId} {

      allow get, list: if isPrivileged();

      allow create, update, delete: if false;
    }

    // =========================================
    // PLATFORM SETTINGS
    // =========================================

    match /platformSettings/{settingId} {

      allow get, list: if activeUser() || isPrivileged();

      allow create, update, delete: if false;
    }

    // =========================================
    // ANNOUNCEMENTS
    // =========================================

    match /announcements/{announcementId} {

      allow get, list: if isPrivileged()
        || (
          activeUser()
          && resource.data.active == true
        );

      allow create, update, delete: if false;
    }

    // =========================================
    // SYSTEM DOCUMENTS
    // =========================================

    match /system/{documentId} {

      allow read, write: if false;
    }

    // =========================================
    // DEFAULT DENY
    // =========================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
