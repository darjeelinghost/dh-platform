rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // AUTHENTICATION HELPERS
    // =========================

    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn()
        && request.auth.token.owner == true;
    }

    function isSuperAdmin() {
      return signedIn()
        && request.auth.token.superAdmin == true;
    }

    function isAdmin() {
      return signedIn()
        && (
          request.auth.token.admin == true
          || isSuperAdmin()
          || isOwner()
        );
    }

    function isSelf(uid) {
      return signedIn()
        && request.auth.uid == uid;
    }

    // =========================
    // USER PROFILES
    // =========================

    match /users/{uid} {

      allow read: if isSelf(uid) || isAdmin();

      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role == "customer"
        && request.resource.data.status == "active"
        && request.resource.data.keys().hasOnly([
          "uid",
          "email",
          "displayName",
          "role",
          "status",
          "createdAt"
        ]);

      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "displayName",
            "phone",
            "photoURL"
          ]);

      allow delete: if isOwner();
    }

    // =========================
    // DRIVER APPLICATIONS
    // =========================

    match /driverApplications/{applicationId} {

      // Driver can create only their own application.
      allow create: if signedIn()
        && applicationId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == "submitted"
        && request.resource.data.verificationStatus == "pending"

        && request.resource.data.keys().hasAll([
          "userId",
          "name",
          "email",
          "phone",
          "whatsappNumber",
          "address",
          "licenceNumber",
          "vehicleType",
          "vehicleNumber",
          "status",
          "verificationStatus",
          "createdAt"
        ])

        && request.resource.data.keys().hasOnly([
          "userId",
          "name",
          "email",
          "phone",
          "whatsappNumber",
          "address",
          "licenceNumber",
          "vehicleType",
          "vehicleNumber",
          "status",
          "verificationStatus",
          "createdAt"
        ])

        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.phone is string
        && request.resource.data.whatsappNumber is string
        && request.resource.data.address is string
        && request.resource.data.licenceNumber is string
        && request.resource.data.vehicleType is string
        && request.resource.data.vehicleNumber is string
        && request.resource.data.createdAt == request.time;

      // Driver can read only their own application.
      // Admin access requires Firebase custom claims.
      allow read: if signedIn()
        && (
          resource.data.userId == request.auth.uid
          || isAdmin()
        );

      // No direct client-side approval or editing.
      allow update, delete: if false;
    }

    // =========================
    // APPROVED DRIVERS
    // =========================

    match /drivers/{driverId} {

      allow read: if isSelf(driverId) || isAdmin();

      // Only trusted backend can write.
      allow write: if false;
    }

    // =========================
    // VEHICLES
    // =========================

    match /vehicles/{vehicleId} {

      allow read: if signedIn()
        && (
          resource.data.driverId == request.auth.uid
          || isAdmin()
        );

      allow write: if false;
    }

    // =========================
    // CUSTOMER ENQUIRIES
    // =========================

    match /enquiries/{enquiryId} {

      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == "submitted";

      allow read: if signedIn()
        && (
          resource.data.customerId == request.auth.uid
          || resource.data.assignedBrokerId == request.auth.uid
          || (
            request.auth.token.driver == true
            && resource.data.assignedDriverId == request.auth.uid
          )
          || isAdmin()
        );

      allow update, delete: if false;
    }

    // =========================
    // ALLOCATIONS
    // =========================

    match /allocations/{allocationId} {

      allow read: if signedIn()
        && (
          resource.data.customerId == request.auth.uid
          || resource.data.driverId == request.auth.uid
          || resource.data.brokerId == request.auth.uid
          || isAdmin()
        );

      allow write: if false;
    }

    // =========================
    // TRIPS
    // =========================

    match /trips/{tripId} {

      allow read: if signedIn()
        && (
          resource.data.customerId == request.auth.uid
          || resource.data.driverId == request.auth.uid
          || resource.data.brokerId == request.auth.uid
          || isAdmin()
        );

      allow write: if false;
    }

    // =========================
    // BROKERS
    // =========================

    match /brokers/{brokerId} {

      allow read: if isSelf(brokerId) || isAdmin();

      allow write: if false;
    }

    // =========================
    // PRIVATE DRIVER DOCUMENTS
    // =========================

    match /privateDriverDocuments/{documentId} {

      allow read, write: if false;
    }

    // =========================
    // AUDIT LOGS
    // =========================

    match /auditLogs/{logId} {

      allow read: if isOwner() || isSuperAdmin();

      allow write: if false;
    }

    // =========================
    // PLATFORM SETTINGS
    // =========================

    match /platformSettings/{settingId} {

      allow read: if isAdmin();

      allow write: if isOwner();
    }

    // =========================
    // DEFAULT DENY
    // =========================

    match /{document=**} {
      allow read, write: if false;
    }

  }
}
