
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* =====================================
       1. AUTHENTICATION AND ROLE HELPERS
    ===================================== */

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() &&
        request.auth.token.admin == true;
    }

    function isSuperAdmin() {
      return signedIn() &&
        request.auth.token.superadmin == true;
    }

    function isPrivileged() {
      return isAdmin() || isSuperAdmin();
    }

    function userExists(uid) {
      return exists(
        /databases/$(database)/documents/users/$(uid)
      );
    }

    function activeUser() {
      return signedIn() &&
        userExists(request.auth.uid) &&
        get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.status == 'active';
    }

    function isDriver() {
      return activeUser() &&
        get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == 'driver';
    }

    function isBroker() {
      return activeUser() &&
        get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == 'broker';
    }


    /* =====================================
       2. USER PROFILES
       Collection: users
    ===================================== */

    match /users/{uid} {

      // Users can read their own profile.
      // Privileged administrators can read all profiles.
      allow get: if isOwner(uid) || isPrivileged();

      // Only administrators can list all user profiles.
      allow list: if isPrivileged();

      // Public registration creates only pending
      // driver or broker accounts.
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasAll([
          'uid',
          'displayName',
          'phone',
          'email',
          'role',
          'status',
          'verificationStatus',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid',
          'displayName',
          'phone',
          'whatsapp',
          'email',
          'role',
          'status',
          'verificationStatus',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in ['driver', 'broker']
        && request.resource.data.status == 'pending'
        && request.resource.data.verificationStatus == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Users can update only ordinary profile fields.
      // Role, status, verification and identity fields
      // cannot be changed through this permission.
      allow update: if isOwner(uid)
        && resource.data.status == 'active'
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'displayName',
            'phone',
            'whatsapp',
            'address',
            'operatingArea',
            'experience',
            'introduction',
            'updatedAt'
          ])
        && request.resource.data.updatedAt == request.time;

      // Account deletion is handled through trusted
      // administrative backend operations.
      allow delete: if false;
    }


    /* =====================================
       3. TRIPS
       Collection: trips
    ===================================== */

    match /trips/{tripId} {

      // Active users can view trip listings.
      // Administrators can also access them.
      allow read: if activeUser() || isPrivileged();

      // Active drivers and brokers can create trips.
      allow create: if activeUser()
        && request.resource.data.postedBy == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.keys().hasAll([
          'postedBy',
          'source',
          'destination',
          'travelDate',
          'tripType',
          'vehicleType',
          'fare',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'postedBy',
          'postedByName',
          'source',
          'destination',
          'pickupLocation',
          'travelDate',
          'pickupTime',
          'tripType',
          'description',
          'vehicleType',
          'seats',
          'passengerSeats',
          'fare',
          'negotiable',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.fare is number
        && request.resource.data.fare >= 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Trip assignment, completion, cancellation
      // and other critical changes must use trusted
      // backend operations.
      //
      // The trip poster can archive or restore their
      // own completed trip without permanently deleting it.
      allow update: if activeUser()
        && resource.data.postedBy == request.auth.uid
        && resource.data.status == 'completed'
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'archived',
            'archivedAt',
            'updatedAt'
          ])
        && request.resource.data.updatedAt == request.time
        && (
          (
            request.resource.data.archived == true
            && request.resource.data.archivedAt == request.time
          )
          ||
          (
            request.resource.data.archived == false
            && request.resource.data.archivedAt == null
          )
        );

      // Trips are soft-archived, never permanently
      // deleted by normal client operations.
      allow delete: if false;
    }


    /* =====================================
       4. TRIP REQUESTS
       Collection: tripRequests
    ===================================== */

    match /tripRequests/{requestId} {

      function tripExists() {
        return request.resource.data.tripId is string
          && exists(
            /databases/$(database)/documents/trips/$(request.resource.data.tripId)
          );
      }

      // Only the requesting driver, trip poster,
      // or privileged administrator can read a request.
      allow read: if activeUser() && (
        resource.data.driverId == request.auth.uid
        ||
        get(
          /databases/$(database)/documents/trips/$(resource.data.tripId)
        ).data.postedBy == request.auth.uid
        ||
        isPrivileged()
      );

      // Only active drivers can submit requests
      // for another user's open trip.
      allow create: if isDriver()
        && tripExists()
        && request.resource.data.driverId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasAll([
          'tripId',
          'driverId',
          'status',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'tripId',
          'driverId',
          'status',
          'message',
          'offerFare',
          'createdAt'
        ])
        && get(
          /databases/$(database)/documents/trips/$(request.resource.data.tripId)
        ).data.status == 'open'
        && get(
          /databases/$(database)/documents/trips/$(request.resource.data.tripId)
        ).data.postedBy != request.auth.uid
        && request.resource.data.createdAt == request.time;

      // Acceptance, rejection and assignment are
      // handled through trusted backend operations.
      allow update, delete: if false;
    }


    /* =====================================
       5. NOTIFICATIONS
       Collection: notifications
    ===================================== */

    match /notifications/{notificationId} {

      // Only the recipient or an administrator
      // can read a notification.
      allow read: if activeUser() && (
        resource.data.recipientId == request.auth.uid
        || isPrivileged()
      );

      // Notifications are created by trusted
      // backend operations, not browser clients.
      allow create: if false;

      // Recipients may mark their own notifications
      // as read. They cannot edit the message,
      // sender or recipient.
      allow update: if activeUser()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'read',
            'readAt'
          ])
        && request.resource.data.read == true
        && request.resource.data.readAt == request.time;

      allow delete: if false;
    }


    /* =====================================
       6. PAYMENT RECORDS
       Collection: paymentRecords
    ===================================== */

    match /paymentRecords/{paymentId} {

      // Only the two trip parties and administrators
      // can read the payment record.
      allow read: if activeUser() && (
        resource.data.driverId == request.auth.uid
        ||
        resource.data.posterId == request.auth.uid
        ||
        isPrivileged()
      );

      // Payment records are created and updated
      // through trusted backend operations.
      allow create, update, delete: if false;
    }


    /* =====================================
       7. COMPLAINTS
       Collection: complaints
    ===================================== */

    match /complaints/{complaintId} {

      // Reporter and privileged administrators
      // can access the complaint.
      allow read: if activeUser() && (
        resource.data.reporterId == request.auth.uid
        ||
        isPrivileged()
      );

      // Active users can submit a complaint.
      allow create: if activeUser()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.keys().hasAll([
          'reporterId',
          'category',
          'description',
          'status',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'reporterId',
          'tripId',
          'category',
          'description',
          'status',
          'createdAt'
        ])
        && request.resource.data.createdAt == request.time;

      // Complaint review and resolution are
      // handled through trusted backend operations.
      allow update, delete: if false;
    }


    /* =====================================
       8. DRIVER DOCUMENTS
       Collection: driverDocuments
    ===================================== */

    match /driverDocuments/{documentId} {

      // Only the document owner and privileged
      // administrators can read document metadata.
      allow read: if activeUser() && (
        resource.data.driverId == request.auth.uid
        ||
        isPrivileged()
      );

      // Document verification and upload metadata
      // must be handled through a controlled process.
      allow create, update, delete: if false;
    }


    /* =====================================
       9. AUDIT LOGS
       Collection: auditLogs
    ===================================== */

    match /auditLogs/{logId} {

      // Administrators can read audit records.
      allow read: if isPrivileged();

      // Browser clients cannot create, edit
      // or delete audit records.
      allow create, update, delete: if false;
    }


    /* =====================================
       10. PLATFORM SETTINGS
       Collection: platformSettings
    ===================================== */

    match /platformSettings/{settingId} {

      // Authenticated active users may read
      // public platform settings.
      allow read: if activeUser();

      // All changes must be performed by
      // trusted backend operations.
      allow create, update, delete: if false;
    }


    /* =====================================
       11. DEFAULT DENY
    ===================================== */

    match /{document=**} {
      allow read, write: if false;
    }

  }
}
