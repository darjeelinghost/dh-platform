
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // AUTHENTICATION HELPERS
    // ==========================================

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() &&
        request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() &&
        request.auth.token.admin == true;
    }

    function isSuperAdmin() {
      return signedIn() &&
        request.auth.token.superadmin == true;
    }

    function isPrivileged() {
      return isAdmin() || isSuperAdmin();
    }

    function userExists(uid) {
      return exists(
        /databases/$(database)/documents/users/$(uid)
      );
    }

    function activeUser() {
      return signedIn() &&
        userExists(request.auth.uid) &&
        get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.status == 'active';
    }

    function validUserRole(role) {
      return role in ['driver', 'broker'];
    }

    // ==========================================
    // USER ACCOUNTS
    // ==========================================

    match /users/{uid} {

      // A user can read their own profile.
      // Administrators can read user profiles.
      allow get: if isOwner(uid) || isPrivileged();

      // Only administrators can list users.
      allow list: if isPrivileged();

      // Public registration: driver or broker only.
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && validUserRole(request.resource.data.role)
        && request.resource.data.status == 'pending'
        && request.resource.data.verificationStatus == 'pending'
        && request.resource.data.keys().hasOnly([
          'uid',
          'displayName',
          'phone',
          'whatsapp',
          'email',
          'role',
          'status',
          'verificationStatus',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Ordinary users can update permitted profile fields only.
      // Role and account status are protected.
      allow update: if (
        isOwner(uid)
        && activeUser()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.verificationStatus ==
          resource.data.verificationStatus
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'displayName',
            'phone',
            'whatsapp',
            'address',
            'operatingArea',
            'experience',
            'introduction',
            'vehicle',
            'photoURL',
            'updatedAt'
          ])
        && request.resource.data.updatedAt == request.time
      ) || isPrivileged();

      // User accounts cannot be deleted from the client.
      allow delete: if false;
    }

    // ==========================================
    // TRIPS
    // ==========================================

    match /trips/{tripId} {

      // Open trips are visible to active users.
      // Trip parties and administrators can access
      // their relevant records.
      allow read: if (
        activeUser()
        && resource.data.status == 'open'
      ) || (
        signedIn()
        && (
          resource.data.postedBy == request.auth.uid
          || resource.data.assignedDriverId == request.auth.uid
        )
      ) || isPrivileged();

      // Active users can create their own trip posts.
      allow create: if activeUser()
        && request.resource.data.postedBy == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.keys().hasOnly([
          'postedBy',
          'posterName',
          'posterRole',
          'pickupLocation',
          'source',
          'destination',
          'travelDate',
          'pickupTime',
          'tripType',
          'description',
          'vehicleType',
          'passengerSeats',
          'fare',
          'negotiable',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Ordinary users can only archive or restore
      // their own completed trip.
      // Assignment and completion are server-controlled.
      allow update: if (
        activeUser()
        && resource.data.postedBy == request.auth.uid
        && resource.data.status == 'completed'
        && request.resource.data.status in [
          'archived',
          'completed'
        ]
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'status',
            'archivedAt',
            'updatedAt'
          ])
        && request.resource.data.updatedAt == request.time
      ) || isPrivileged();

      // Permanent deletion is not allowed from the client.
      allow delete: if false;
    }

    // ==========================================
    // TRIP REQUESTS
    // ==========================================

    match /tripRequests/{requestId} {

      function tripExists() {
        return exists(
          /databases/$(database)/documents/trips/$(request.resource.data.tripId)
        );
      }

      function tripIsNotOwnedByRequester() {
        return tripExists()
          && get(
            /databases/$(database)/documents/trips/$(request.resource.data.tripId)
          ).data.postedBy != request.auth.uid;
      }

      function tripIsOpen() {
        return tripExists()
          && get(
            /databases/$(database)/documents/trips/$(request.resource.data.tripId)
          ).data.status == 'open';
      }

      allow create: if activeUser()
        && request.resource.data.driverId == request.auth.uid
        && request.resource.data.status == 'pending'
        && tripIsNotOwnedByRequester()
        && tripIsOpen()
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == 'driver'
        && request.resource.data.keys().hasOnly([
          'tripId',
          'driverId',
          'driverName',
          'message',
          'offerAmount',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow read: if signedIn()
        && (
          resource.data.driverId == request.auth.uid
          || (
            exists(
              /databases/$(database)/documents/trips/$(resource.data.tripId)
            )
            && get(
              /databases/$(database)/documents/trips/$(resource.data.tripId)
            ).data.postedBy == request.auth.uid
          )
        ) || isPrivileged();

      // Decisions and assignment must be made by
      // trusted server-side operations.
      allow update, delete: if false;
    }

    // ==========================================
    // NOTIFICATIONS
    // ==========================================

    match /notifications/{notificationId} {

      allow read: if signedIn()
        && resource.data.recipientId == request.auth.uid
        || isPrivileged();

      // Only the recipient can mark their notification
      // as read. They cannot change its message or owner.
      allow update: if signedIn()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.recipientId ==
          resource.data.recipientId
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'read',
            'readAt'
          ]);

      // Notifications are created by trusted server code.
      allow create, delete: if false;
    }

    // ==========================================
    // PAYMENT RECORDS
    // ==========================================

    match /paymentRecords/{paymentId} {

      allow read: if signedIn()
        && (
          resource.data.driverId == request.auth.uid
          || resource.data.posterId == request.auth.uid
        ) || isPrivileged();

      // Payment changes must be handled by
      // trusted server-side operations.
      allow create, update, delete: if false;
    }

    // ==========================================
    // COMPLAINTS
    // ==========================================

    match /complaints/{complaintId} {

      allow create: if activeUser()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.keys().hasOnly([
          'reporterId',
          'tripId',
          'againstUserId',
          'subject',
          'description',
          'status',
          'createdAt'
        ])
        && request.resource.data.createdAt == request.time;

      allow read: if signedIn()
        && resource.data.reporterId == request.auth.uid
        || isPrivileged();

      // Complaint decisions are administrator-controlled.
      allow update, delete: if false;
    }

    // ==========================================
    // DRIVER DOCUMENT METADATA
    // ==========================================

    match /driverDocuments/{documentId} {

      allow read: if signedIn()
        && (
          resource.data.ownerId == request.auth.uid
          || isPrivileged()
        );

      // Document metadata and verification status
      // are managed through trusted server operations.
      allow create, update, delete: if false;
    }

    // ==========================================
    // AUDIT LOGS
    // ==========================================

    match /auditLogs/{logId} {

      allow read: if isPrivileged();

      // Audit entries must be created by trusted server code.
      allow create, update, delete: if false;
    }

    // ==========================================
    // PLATFORM SETTINGS
    // ==========================================

    match /platformSettings/{settingId} {

      allow read: if activeUser() || isPrivileged();

      // Only trusted server operations can change settings.
      allow create, update, delete: if false;
    }

    // ==========================================
    // DEFAULT DENY
    // ==========================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
