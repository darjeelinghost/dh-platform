rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // AUTHENTICATION HELPERS
    // =========================

    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn()
        && request.auth.token.get('owner', false) == true;
    }

    function isSuperAdmin() {
      return signedIn()
        && request.auth.token.get('superAdmin', false) == true;
    }

    function isAdmin() {
      return signedIn()
        && (
          request.auth.token.get('admin', false) == true
          || isSuperAdmin()
          || isOwner()
        );
    }

    function isSelf(uid) {
      return signedIn()
        && request.auth.uid == uid;
    }

    function isValidString(val, min, max) {
      return val is string
        && val.size() >= min
        && val.size() <= max;
    }

    // =========================
    // USER PROFILES
    // =========================

    match /users/{uid} {

      allow read: if isSelf(uid) || isAdmin();

      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role == "customer"
        && request.resource.data.status == "active"
        && request.resource.data.keys().hasAll([
          "uid",
          "email",
          "displayName",
          "role",
          "status",
          "createdAt"
        ])
        && request.resource.data.keys().hasOnly([
          "uid",
          "email",
          "displayName",
          "role",
          "status",
          "createdAt"
        ])
        && isValidString(request.resource.data.email, 3, 254)
        && isValidString(request.resource.data.displayName, 1, 100)
        && request.resource.data.createdAt is timestamp;

      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "displayName",
            "phone",
            "photoURL"
          ])
        && (!("displayName" in request.resource.data) || isValidString(request.resource.data.displayName, 1, 100))
        && (!("phone" in request.resource.data) || isValidString(request.resource.data.phone, 5, 20))
        && (!("photoURL" in request.resource.data) || isValidString(request.resource.data.photoURL, 1, 500));

      allow delete: if isOwner();
    }

    // =========================
    // DRIVER APPLICATIONS
    // =========================

    match /driverApplications/{applicationId} {

      allow create: if isSelf(applicationId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == "submitted"
        && request.resource.data.verificationStatus == "pending"
        && request.resource.data.keys().hasAll([
          "userId",
          "name",
          "email",
          "phone",
          "whatsappNumber",
          "address",
          "licenceNumber",
          "vehicleType",
          "vehicleNumber",
          "status",
          "verificationStatus",
          "createdAt"
        ])
        && request.resource.data.keys().hasOnly([
          "userId",
          "name",
          "email",
          "phone",
          "whatsappNumber",
          "address",
          "licenceNumber",
          "vehicleType",
          "vehicleNumber",
          "status",
          "verificationStatus",
          "createdAt"
        ])
        && isValidString(request.resource.data.name, 2, 100)
        && isValidString(request.resource.data.email, 3, 254)
        && isValidString(request.resource.data.phone, 5, 20)
        && isValidString(request.resource.data.whatsappNumber, 5, 20)
        && isValidString(request.resource.data.address, 5, 500)
        && isValidString(request.resource.data.licenceNumber, 3, 50)
        && isValidString(request.resource.data.vehicleType, 2, 50)
        && isValidString(request.resource.data.vehicleNumber, 3, 30)
        && request.resource.data.createdAt is timestamp;

      // Using isSelf(applicationId) allows the user to check if their application doc existseven when null
      allow read: if isSelf(applicationId) || isAdmin();

      allow update, delete: if false;
    }

    // =========================
    // APPROVED DRIVERS
    // =========================

    match /drivers/{driverId} {
      allow read: if isSelf(driverId) || isAdmin();
      allow write: if false;
    }

    // =========================
    // VEHICLES
    // =========================

    match /vehicles/{vehicleId} {
      allow read: if signedIn()
        && (
          resource.data.driverId == request.auth.uid
          || isAdmin()
        );
      allow write: if false;
    }

    // =========================
    // CUSTOMER ENQUIRIES
    // =========================

    match /enquiries/{enquiryId} {

      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == "submitted"
        && request.resource.data.createdAt is timestamp
        // Prevent clients from pre-assigning drivers or brokers upon creation
        && !("assignedBrokerId" in request.resource.data)
        && !("assignedDriverId" in request.resource.data);

      allow read: if signedIn()
        && (
          resource.data.customerId == request.auth.uid
          || resource.data.get('assignedBrokerId', '') == request.auth.uid
          || (
            request.auth.token.get('driver', false) == true
            && resource.data.get('assignedDriverId', '') == request.auth.uid
          )
          || isAdmin()
        );

      allow update, delete: if false;
    }

    // =========================
    // ALLOCATIONS
    // =========================

    match /allocations/{allocationId} {
      allow read: if signedIn()
        && (
          resource.data.customerId == request.auth.uid
          || resource.data.get('driverId', '') == request.auth.uid
          || resource.data.get('brokerId', '') == request.auth.uid
          || isAdmin()
        );
      allow write: if false;
    }

    // =========================
    // TRIPS
    // =========================

    match /trips/{tripId} {
      allow read: if signedIn()
        && (
          resource.data.customerId == request.auth.uid
          || resource.data.get('driverId', '') == request.auth.uid
          || resource.data.get('brokerId', '') == request.auth.uid
          || isAdmin()
        );
      allow write: if false;
    }

    // =========================
    // BROKERS
    // =========================

    match /brokers/{brokerId} {
      allow read: if isSelf(brokerId) || isAdmin();
      allow write: if false;
    }

    // =========================
    // PRIVATE DRIVER DOCUMENTS
    // =========================

    match /privateDriverDocuments/{documentId} {
      allow read, write: if false;
    }

    // =========================
    // AUDIT LOGS
    // =========================

    match /auditLogs/{logId} {
      allow read: if isOwner() || isSuperAdmin();
      allow write: if false;
    }

    // =========================
    // PLATFORM SETTINGS
    // =========================

    match /platformSettings/{settingId} {
      allow read: if isAdmin();
      allow write: if isOwner();
    }
  }
}
